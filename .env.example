# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# URL pública del backend. En local se deja vacía; en Render: https://<servicio>.onrender.com
PUBLIC_URL=
# true detrás de un proxy (Render). En local, false.
IS_PROXIED=false

# ---------------------------------------------------------------------------
# Secretos de Strapi (generar valores propios, p. ej. `openssl rand -base64 32`)
# APP_KEYS acepta varias claves separadas por coma.
# ---------------------------------------------------------------------------
APP_KEYS="clave-ejemplo-1,clave-ejemplo-2"
API_TOKEN_SALT=salt-ejemplo
ADMIN_JWT_SECRET=secreto-ejemplo
TRANSFER_TOKEN_SALT=salt-ejemplo
JWT_SECRET=secreto-ejemplo
ENCRYPTION_KEY=clave-ejemplo

# ---------------------------------------------------------------------------
# Base de datos (Postgres en Supabase, connection pooler)
# ---------------------------------------------------------------------------
DATABASE_CLIENT=postgres
DATABASE_HOST=aws-0-sa-east-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres.tu-project-ref
DATABASE_PASSWORD=password-ejemplo
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# CA de Supabase (Database Settings > SSL Configuration > Download certificate).
# Local: ruta al archivo .crt (está en .gitignore, no se sube).
DATABASE_SSL_CA_FILE=./prod-ca-2021.crt
# Render: pegar el contenido completo del .crt (PEM) en esta variable y no usar DATABASE_SSL_CA_FILE.
# DATABASE_SSL_CA=
# Pool chico: el plan gratuito de Supabase tiene pocas conexiones.
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Supabase Storage (S3 compatible) para la subida de imágenes
# Las credenciales se generan en Supabase > Storage > S3 Connection.
# SUPABASE_PUBLIC_URL es la URL pública del bucket, incluido el nombre del bucket.
# ---------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT=https://tu-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=sa-east-1
SUPABASE_S3_ACCESS_KEY_ID=access-key-ejemplo
SUPABASE_S3_SECRET_ACCESS_KEY=secret-key-ejemplo
SUPABASE_S3_BUCKET=uploads
SUPABASE_PUBLIC_URL=https://tu-project-ref.supabase.co/storage/v1/object/public/uploads

# ---------------------------------------------------------------------------
# Node (solo producción / Render): limita el heap para entrar en 512 MB
# ---------------------------------------------------------------------------
# NODE_OPTIONS=--max-old-space-size=400
